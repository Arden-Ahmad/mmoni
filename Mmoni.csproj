<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mmoni.ico</ApplicationIcon>
    <AssemblyName>Mmoni</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Mmoni</Product>
    <Authors>Mmoni</Authors>
    <Company>Mmoni</Company>
    <Description>Minimal Windows desktop hardware overlay for CPU and GPU temperature, power, load, and clocks.</Description>
    <Copyright>Copyright (c) 2026 Mmoni</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="Assets\Mmoni.ico" />
  </ItemGroup>
</Project>

