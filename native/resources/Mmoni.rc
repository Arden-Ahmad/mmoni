#include <windows.h>
#include "resource.h"

IDI_MMONI_APP            ICON    "..\\..\\Assets\\Mmoni.ico"

IDR_PAWNIO_INTEL_MSR     RCDATA  "pawnio\\IntelMSR.bin"
IDR_PAWNIO_AMD_FAM17     RCDATA  "pawnio\\AMDFamily17.bin"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMONI_VERSION_MAJOR,MMONI_VERSION_MINOR,MMONI_VERSION_PATCH,0
 PRODUCTVERSION MMONI_VERSION_MAJOR,MMONI_VERSION_MINOR,MMONI_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mmoni"
            VALUE "FileDescription", "Minimal Windows 11 native hardware telemetry overlay."
            VALUE "FileVersion", MMONI_FILE_VERSION
            VALUE "InternalName", "Mmoni"
            VALUE "LegalCopyright", "Copyright (c) 2026 Mmoni"
            VALUE "OriginalFilename", "Mmoni.exe"
            VALUE "ProductName", "Mmoni"
            VALUE "ProductVersion", MMONI_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
